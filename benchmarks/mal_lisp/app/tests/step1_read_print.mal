;; Testing keywords
:kw
;=>:kw
(:kw1 :kw2 :kw3)
;=>(:kw1 :kw2 :kw3)

;; Testing vectors
[+ 1 (+ 2 3)]
;=>[+ 1 (+ 2 3)]
  [ +   1 (+ 2 3   )   ]  
;=>[+ 1 (+ 2 3)]
([])
;=>([])
[]
;=>[]

;; Testing hash maps
{}
;=>{}
{ }
;=>{}
{"abc" 1}
;=>{"abc" 1}
{"a" {"b" 2}}
;=>{"a" {"b" 2}}
{"a" {"b" {"c" 3}}}
;=>{"a" {"b" {"c" 3}}}
{  "a"  {"b"   {  "cde"     3   }  }}
;=>{"a" {"b" {"cde" 3}}}
{:a 1}
;=>{:a 1}
{"a" 1 :a 2}
;=>{"a" 1 :a 2}
{"a" 1 "a" 2}
;=>{"a" 2}
{"a"}
;/.*(even|odd|key|value).*

;; Testing comments
;; whole-line comment
1 ; trailing comment
;=>1
(1 ; inside
;/.*(EOF|end of input|unbalanced).*
"a;b" ; c
;=>"a;b"

;; Testing reader macros
'1
;=>(quote 1)
'(1 2 3)
;=>(quote (1 2 3))
`1
;=>(quasiquote 1)
`(1 2 3)
;=>(quasiquote (1 2 3))
~1
;=>(unquote 1)
~(1 2 3)
;=>(unquote (1 2 3))
`(1 ~a 3)
;=>(quasiquote (1 (unquote a) 3))
~@(1 2 3)
;=>(splice-unquote (1 2 3))
`(1 ~@a 3)
;=>(quasiquote (1 (splice-unquote a) 3))
@a
;=>(deref a)
@(f)
;=>(deref (f))
^{"a" 1} [1 2 3]
;=>(with-meta [1 2 3] {"a" 1})
^:k abc
;=>(with-meta abc :k)
'a 'b
;=>(quote a)
