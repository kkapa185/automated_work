;; Testing REPL_ENV (guide examples)
(+ 1 2)
;=>3
(/ (- (+ 5 (* 2 3)) 3) 4)
;=>2

;; Testing def!
(def! x 3)
;=>3
x
;=>3
(def! x 4)
;=>4
x
;=>4
(def! y (+ 1 7))
;=>8
y
;=>8
(def! a 6)
;=>6
a
;=>6
(def! b (+ a 2))
;=>8
(+ a b)
;=>14

;; Verifying symbols are case-sensitive
(def! mynum 111)
;=>111
(def! MYNUM 222)
;=>222
mynum
;=>111
MYNUM
;=>222

;; Check env lookup non-fatal error
(abc 1 2 3)
;/.*\'abc\' not found.*

;; Check that error aborts def!
(def! w 123)
;=>123
(def! w (abc))
;/.*\'abc\' not found.*
w
;=>123

;; Testing let*
(let* (z 9) z)
;=>9
(let* (x 9) x)
;=>9
x
;=>4
(let* (z (+ 2 3)) (+ 1 z))
;=>6
(let* (p (+ 2 3) q (+ 2 p)) (+ p q))
;=>12
(def! y (let* (z 7) z))
;=>7
y
;=>7
(let* (c 2) c)
;=>2

;; Testing outer environment
(def! a 4)
;=>4
(let* (q 9) q)
;=>9
(let* (q 9) a)
;=>4
(let* (z 2) (let* (q 9) a))
;=>4
(let* (x 4) (def! a 5))
;=>5
a
;=>4

;; Testing let* with vector bindings
(let* [z 9] z)
;=>9
(let* [p (+ 2 3) q (+ 2 p)] (+ p q))
;=>12

;; Testing vector evaluation
(let* (a 5 b 6) [3 4 a [b 7] 8])
;=>[3 4 5 [6 7] 8]

;; let* scope is discarded and bindings may shadow
(def! s 1)
;=>1
(let* (s 2) (let* (s (+ s 1)) s))
;=>3
s
;=>1

;; Malformed let*/def! are errors, not crashes
(let* (a) a)
;/.*Error.*
(let* 5 a)
;/.*Error.*
(def! 1 2)
;/.*Error.*
(+ 1 2)
;=>3

;; DEBUG-EVAL
(def! DEBUG-EVAL true)
;=>true
;; With DEBUG-EVAL on, EVAL prints "EVAL: ast" lines before the result
(+ 1 2)
;/(?s)EVAL: \(\+ 1 2\)\nEVAL: \+\nEVAL: 1\nEVAL: 2\n3
(def! DEBUG-EVAL nil)
;/(?s).*nil
(+ 1 2)
;=>3
