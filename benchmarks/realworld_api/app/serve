#!/usr/bin/env python3
"""Start the Conduit API: ./serve --port <port>"""
import argparse
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from conduit.server import create_server  # noqa: E402


def main():
    p = argparse.ArgumentParser(description="Conduit API server")
    p.add_argument("--port", type=int, default=8000)
    args = p.parse_args()
    srv = create_server("127.0.0.1", args.port)
    print("Conduit API listening on http://127.0.0.1:%d/api" % args.port, flush=True)
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
